# Portfolio photos and videos. Leave these empty in development: files are saved on this computer.
# When the app is online, create a PUBLIC bucket named "portfolio" in Supabase Storage and fill these in.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_KEY=your-secret-key
# SUPABASE_BUCKET=portfolio

# Email through Resend (resend.com). Leave RESEND_API_KEY empty in development: emails print in this terminal instead.
# To email real people you must verify your own domain in Resend and set MAIL_FROM to an address on it.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Lyf <hello@yourdomain.com>
# Public address of the app, used in email links.
APP_URL=http://localhost:5173
